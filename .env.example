# Copy to .env and fill real values. Never commit .env.

# Investment / thresholds
TOTAL_INVESTMENT=100.0
MIN_MARGIN_THRESHOLD=1.5

# Telegram bot credentials (from @BotFather — never hardcode in source)
# Railway may use TELEGRAM_TOKEN; local .env often uses TELEGRAM_BOT_TOKEN
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# SQLite
DB_PATH=data/arb_scanner.db

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
