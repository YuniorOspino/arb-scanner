# Copy to .env and fill real values. Never commit .env.

# Investment / thresholds
TOTAL_INVESTMENT=100.0
MIN_MARGIN_THRESHOLD=1.5
# Max best-ROI alerts to enqueue/send per scan cycle
MAX_ALERTS_PER_CYCLE=3

# Telegram bot credentials (from @BotFather — never hardcode in source)
# Railway may use TELEGRAM_TOKEN; local .env often uses TELEGRAM_BOT_TOKEN
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# SQLite
DB_PATH=data/arb_scanner.db

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Public URL for launcher pages (Railway)
# Prefer full URL; otherwise RAILWAY_PUBLIC_DOMAIN is used as https://{domain}
BASE_URL=https://tu-proyecto.up.railway.app
# RAILWAY_PUBLIC_DOMAIN=tu-proyecto.up.railway.app
PORT=8000
# 0 = envío inmediato (recomendado). >0 espera N segundos para agrupar por ROI.
BUFFER_VENTANA_SEG=0

# --- Filtro de alertas ejecutables (Telegram) ---
# ALERT_ROI_MIN defaults to MIN_MARGIN_THRESHOLD if unset
# ALERT_ROI_MIN=1.5
# ALERT_ROI_MAX=30
# ALERT_MIN_STAKE=5000
# ALERT_FRAGILE_ROI_EXTRA=1.5
# ALERT_MAX_AGE_SECONDS=90
# Forzar re-scrape de cuotas antes de encolar (más lento; default off)
# REVERIFY_ODDS_BEFORE_ALERT=0

# --- Alerta "💎 PROYECCIÓN ALTA" (arb de alta calidad aparente) ---
# Score 0–100 = ROI + estabilidad mercado + liquidez stakes
# QUALITY_SCORE_MIN=70
# PROYECCION_ROI_MIN=2.5

# --- Ejecución semi-auto (sesiones de casas) ---
# playwright (default) | camoufox
# EXECUTION_BROWSER=playwright
# EXECUTION_SESSIONS_DIR=data/sessions
